# ZCode VPS 中继 —— 发布用变体：把 web bundle 一并烘进镜像。
#
# 与 Dockerfile 的唯一差别是「bundle 进镜像」而不是走 bind mount：
# 这样「镜像版本 = 手机页版本」，配合 .github/workflows/release-fork.yml 的 relay job
# 由 CI 构建推送，中继就不会再和桌面版本漂移（原先靠手动 scp web/）。
#
# ⚠ 构建上下文必须是**仓库根**，不是本目录：镜像要从 packages/web/dist 取前端产物。
#   仓库根的 .dockerignore 已用 `!packages/web/dist/**` 把它放行；而本目录的 .dockerignore
#   会排除 web/ —— 所以**不能**拿本目录当上下文。
#
#   docker build -f deploy/vps-relay/Dockerfile.release -t <tag> .
#
# 构建前建议剔除 source map（约 86M，中继只服务手机页，用不到）：
#   find packages/web/dist -name '*.map' -delete

FROM node:22-alpine

WORKDIR /app

# relay 的唯一外部依赖。锁大版本，避免上游 breaking change 直接打进来。
RUN npm install --no-save --no-audit --no-fund ws@8

COPY deploy/vps-relay/relay.mjs ./

# web bundle：与 relay 同版本发布，不再靠 bind mount。
COPY packages/web/dist/ /app/web/

ENV PORT=3180 \
    WEB_ROOT=/app/web

EXPOSE 3180

# 用非 root 运行。
USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3180)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "relay.mjs"]
