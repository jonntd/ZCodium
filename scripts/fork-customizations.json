{
  "$comment": "fork 定制登记表：merge:impact（scripts/merge-main-impact-check.mjs）用它把命中的交集文件标成最高危并点名定制点；scripts/fork-customization-guard.test.mjs 用它断言每个定制点在 HEAD 的存活状态。新增 fork 定制时的动作：先写 spec，再在此登记一条（contains 选上游不会无意写出的稳定标记串），守护测试自动生效。",
  "customizations": [
    {
      "id": "dmg-install-guide",
      "title": "DMG 安装引导布局与解除拦截说明文件",
      "spec": "packages/desktop/specs/macos-dmg-installation.md",
      "guardTest": "packages/desktop/test/dmgInstallGuideLayout.test.ts",
      "markers": [
        {
          "file": "packages/desktop/electron-builder.config.js",
          "contains": "build/dmg/解除拦截.txt"
        },
        { "file": "packages/desktop/electron-builder.config.js", "contains": "{ x: 150, y: 120 }" }
      ]
    },
    {
      "id": "fork-app-identity",
      "title": "应用身份（正式档兜底名 ZCodium，独立 userData/单实例锁）",
      "spec": "packages/desktop/specs/fork-app-identity.md",
      "markers": [
        { "file": "packages/desktop/src/main/desktopRuntimeEnv.ts", "contains": ": \"ZCodium\");" }
      ]
    },
    {
      "id": "github-update-provider",
      "title": "自动更新源指向 fork 的 GitHub Releases",
