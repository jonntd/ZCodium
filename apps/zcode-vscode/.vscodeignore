# .vsix 只保留 dist + media + package.json，规避 vsce 依赖树打包问题（node_modules 必须为 0）
.vscode/**
src/**
test/**
scripts/**
out/**
# 运行时 IDE 发现信标（含 authToken，瞬态增删）：不打包（防凭据泄漏 + vsce stat 竞态崩溃）
ide/**
# 开发态产物（§首行注释「.vsix 只保留 dist + media + package.json」的补齐面）
.zcode/**
.workbuddy/**
docs/**
e2e/**
node_modules/@vitest/**
node_modules/@zcode/**
node_modules/vitest/**
node_modules/.bin/**
node_modules/.pnpm/**
dist/**/*.map
esbuild.mjs
vitest.config.ts
tsconfig.json
**/*.ts
**/*.tsx
**/*.mts
**/.gitignore
