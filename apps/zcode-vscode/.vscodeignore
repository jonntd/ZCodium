# .vsix 只保留 dist + media + package.json，规避 vsce 依赖树打包问题（node_modules 必须为 0）
.vscode/**
src/**
test/**
scripts/**
out/**
node_modules/@vitest/**
node_modules/@zcode/**
node_modules/vitest/**
node_modules/.bin/**
node_modules/.pnpm/**
dist/**/*.map
esbuild.mjs
vitest.config.ts
tsconfig.json
**/*.ts
**/*.tsx
**/*.mts
**/.gitignore
