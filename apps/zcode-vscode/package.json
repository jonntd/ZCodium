{
  "name": "code",
  "displayName": "Code",
  "description": "把 Code 接进 VS Code：与桌面端同源的 @zcode/ui 对话界面、流式回复、工具时间线、审批与断线恢复。",
  "version": "0.2.0",
  "publisher": "zcodium",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "agent",
    "chat",
    "code"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zcodium/zcode",
    "directory": "apps/zcode-vscode"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code",
          "title": "Code",
          "icon": "media/zcodium.svg"
        }
      ]
    },
    "views": {
      "code": [
        {
          "id": "code.chat",
          "name": "对话",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "code.openChat",
        "title": "打开对话",
        "category": "ZCodium"
      },
      {
        "command": "code.onboarding",
        "title": "上手引导",
        "category": "ZCodium"
      },
      {
        "command": "code.newSession",
        "title": "新建会话",
        "category": "ZCodium",
        "icon": "$(add)"
      },
      {
        "command": "code.restartAgent",
        "title": "重启 Agent 进程",
        "category": "ZCodium",
        "icon": "$(refresh)"
      },
      {
        "command": "code.showLogs",
        "title": "显示 ZCodium 日志",
        "category": "ZCodium"
      },
      {
        "command": "code.checkBundleSize",
        "title": "检查 Webview/Host 产物体积门禁",
        "category": "ZCodium"
      },
      {
        "command": "code.switchWorkspace",
        "title": "切换工作区",
        "category": "ZCodium",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "code.sendDiagnostics",
        "title": "发送诊断信息",
        "category": "ZCodium"
      },
      {
        "command": "code.openMcpSettings",
        "title": "打开 MCP 设置",
        "category": "ZCodium"
      },
      {
        "command": "code.openInstructions",
        "title": "打开指令配置",
        "category": "ZCodium"
      },
      {
        "command": "code.openSessionParams",
        "title": "打开会话参数",
        "category": "ZCodium"
      },
      {
        "command": "code.importClaudeSessions",
        "title": "导入 Claude 会话",
        "category": "ZCodium"
      },
      {
        "command": "code.showSubagents",
        "title": "查看子代理",
        "category": "ZCodium"
      },
      {
        "command": "code.openUsage",
        "title": "查看用量",
        "category": "ZCodium"
      },
      {
        "command": "code.quickEdit",
        "title": "改写选中代码（Quick Edit）",
        "category": "ZCodium"
      },
      {
        "command": "code.sendTerminalSelection",
        "title": "发送终端选区到 ZCodium",
        "category": "ZCodium"
      },
      {
        "command": "code.generateCommitMessage",
        "title": "生成提交信息",
        "category": "ZCodium"
      },
      {
        "command": "code.reviewChanges",
        "title": "审阅当前改动",
        "category": "ZCodium"
      },
      {
        "command": "code.pickSession",
        "title": "历史会话",
        "category": "ZCodium",
        "icon": "$(history)"
      },
      {
        "command": "code.codeAction",
        "title": "ZCodium 代码操作",
        "category": "ZCodium"
      },
      {
        "command": "code.addRangeToChat",
        "title": "把选中范围加入对话",
        "category": "ZCodium"
      },
      {
        "command": "code.fixDiagnostics",
        "title": "用 ZCodium 修复诊断",
        "category": "ZCodium"
      },
      {
        "command": "code.explainSelection",
        "title": "解释选中的代码",
        "category": "ZCodium"
      },
      {
        "command": "code.fixSelection",
        "title": "修复选中的代码",
        "category": "ZCodium"
      },
      {
        "command": "code.refactorSelection",
        "title": "重构选中的代码",
        "category": "ZCodium"
      },
      {
        "command": "code.writeTests",
        "title": "为选中的代码写测试",
        "category": "ZCodium"
      },
      {
        "command": "code.addToContext",
        "title": "加入对话上下文",
        "category": "ZCodium"
      },
      {
        "command": "code.showEditorLogs",
        "title": "显示编辑器功能日志",
        "category": "ZCodium"
      },
      {
        "command": "code.stop",
        "title": "停止生成",
        "category": "ZCodium",
        "icon": "$(debug-stop)"
      },
      {
        "command": "code.addFileToContext",
        "title": "加入 ZCodium 对话",
        "category": "ZCodium"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "code.newSession",
          "when": "view == code.chat",
          "group": "navigation@1"
        },
        {
          "command": "code.restartAgent",
          "when": "view == code.chat",
          "group": "1_manage@1"
        },
        {
          "command": "code.switchWorkspace",
          "when": "view == code.chat",
          "group": "1_manage@2"
        },
        {
          "command": "code.pickSession",
          "when": "view == code.chat",
          "group": "navigation@2"
        },
        {
          "command": "code.stop",
          "when": "view == code.chat",
          "group": "1_manage@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "code.editorContext",
          "group": "1_code@1",
          "when": "editorHasSelection"
        }
      ],
      "code.editorContext": [
        {
          "command": "code.explainSelection",
          "group": "1_assist@1"
        },
        {
          "command": "code.fixSelection",
          "group": "1_assist@2"
        },
        {
          "command": "code.refactorSelection",
          "group": "1_assist@3"
        },
        {
          "command": "code.writeTests",
          "group": "1_assist@4"
        },
        {
          "command": "code.addToContext",
          "group": "2_context@1"
        }
      ],
      "commandPalette": [
        {
          "command": "code.codeAction",
          "when": "false"
        },
        {
          "command": "code.addRangeToChat",
          "when": "false"
        },
        {
          "command": "code.fixDiagnostics",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "code.generateCommitMessage",
          "group": "navigation@10"
        },
        {
          "command": "code.reviewChanges",
          "group": "navigation@11"
        }
      ],
      "terminal/context": [
        {
          "command": "code.sendTerminalSelection",
          "group": "1_code@1"
        }
      ],
      "explorer/context": [
        {
          "command": "code.addFileToContext",
          "group": "7_gode@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "code.addFileToContext",
          "group": "1_code@1"
        }
      ]
    },
    "configuration": {
      "title": "Code",
      "properties": {
        "code.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`zcodium` CLI 可执行文件绝对路径。留空时从 `PATH` 探测 `zcodium`。"
        },
        "code.mode": {
          "type": "string",
          "enum": [
            "build",
            "plan",
            "edit",
            "guarded",
            "yolo",
            "auto"
          ],
          "default": "build",
          "markdownDescription": "Agent 工作模式，经 HostSettingsBridge 归一为 RuntimeController 编排面（恢复/编程式创建）的 `create.config.mode`。侧栏对话区草稿会话走 v4 createSession（模式在会话头部切换），不读取本设置。"
        },
        "code.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "模型选择，格式 `providerId/modelId`，经 HostSettingsBridge 归一为 RuntimeController 编排面（恢复/编程式创建）的下发参数；留空使用 CLI 默认模型。侧栏对话区草稿会话的模型在会话头部切换，不读取本设置。"
        },
        "code.permissions.allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "工具 allowlist 规则（支持 `Tool` 与 `Tool(args)` 形式），随 create/resume 携带（P1-3）。"
        },
        "code.permissions.denylist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "工具 denylist 规则，随 create/resume 携带；resume 不带会绕过约束。"
        },
        "code.mcp.servers": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": [],
          "markdownDescription": "MCP 服务器配置（stdio/http，字段对齐 zcodeProtocolMcpServerSchema），改动后需重建会话生效（P1-8）。"
        },
        "code.context.additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "maxItems": 256,
          "markdownDescription": "Agent 可访问的附加目录（协议上限 256 个，P1-16.1）。"
        },
        "code.autoContext": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "openEditors",
            "openEditorsAndRecentEdits"
          ],
          "enumDescriptions": [
            "关闭自动上下文",
            "附加打开中的文件路径与光标行",
            "再加最近 5 分钟内编辑过的文件"
          ],
          "description": "发送消息时自动附加的编辑器上下文（FR-B22）。"
        }
      }
    },
    "submenus": [
      {
        "id": "code.editorContext",
        "label": "ZCodium"
      }
    ],
    "keybindings": [
      {
        "command": "code.quickEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection && editorTextFocus"
      },
      {
        "command": "code.addToContext",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "size": "node scripts/check-bundle-size.mjs",
    "package": "node esbuild.mjs && vsce package --no-dependencies --out dist/ && node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@zcode/client": "workspace:*",
    "@zcode/rpc": "workspace:*",
    "@zcode/services": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/ui": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.7",
    "@tailwindcss/node": "^4.1.7",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "0.25.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
