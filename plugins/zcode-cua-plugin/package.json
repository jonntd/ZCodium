{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/zcode-cua-plugin",
  "version": "0.6.5",
  "private": true,
  "description": "ZCode CUA SDK and skill package; execution is provided by the shared node_repl host.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./scripts/computer-use-client.mjs",
  "scripts": {
    "build": "node scripts/check-sdk.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "sync:skill": "node scripts/sync-skill-from-zcode-cua.mjs",
    "sync:cache": "node scripts/sync-cache.mjs",
    "sync:all": "pnpm sync:skill && pnpm build && pnpm sync:cache",
    "test": "pnpm run build && node --test tests/*.node-test.mjs",
    "typecheck": "node scripts/check-sdk.mjs"
  },
  "dependencies": {
    "@zcode/zcode-cua": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
